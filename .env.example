# =============================================================================
# Blipps API — Environment Variables Template
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Neon Postgres — USE THE POOLER URL (PgBouncer handles connection reuse)
# For Alembic migrations (DDL), use DATABASE_URL_UNPOOLED instead.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:YOURPASSWORD@ep-wispy-cell-avnuagc7-pooler.c-11.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOURPASSWORD@ep-wispy-cell-avnuagc7.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# JWT Auth
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_HOURS=24

# -----------------------------------------------------------------------------
# Backblaze B2 Object Storage (S3-Compatible API)
# Bucket: Blipp-bucket (Private)
# -----------------------------------------------------------------------------
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_KEY_ID=YOUR_B2_KEY_ID
B2_APP_KEY=YOUR_B2_APPLICATION_KEY
B2_BUCKET_NAME=Blipp-bucket
PRESIGN_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Redis (Vercel Redis / Upstash)
# -----------------------------------------------------------------------------
REDIS_URL=redis://default:YOURPASSWORD@your-redis-host.upstash.io:PORT

# -----------------------------------------------------------------------------
# Docker Hub (for CI/CD build & push)
# -----------------------------------------------------------------------------
DOCKERHUB_USERNAME=YOUR_DOCKERHUB_USERNAME
DOCKERHUB_TOKEN=dckr_pat_YOUR_TOKEN_HERE
